# ==========================================
# Configurações do Servidor
# ==========================================
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# ==========================================
# PostgreSQL Database
# ==========================================
USER_DATABASE_DEV=postgres
HOST_DATABASE_DEV=localhost
DB_DATABASE_DEV=zendabot_db
PS_DATABASE_DEV=postgres123
PORT_DATABASE_DEV=5432

# ==========================================
# Segurança e Autenticação
# ==========================================
JWT_SECRET_KEY=sua_chave_secreta_jwt_super_segura_aqui

# ==========================================
# Provedor de IA (Multi-LLM: Gemini, Groq, OpenAI, Claude)
# ==========================================
# Escolha entre: "gemini" (padrão), "groq", "openai", "claude"
AI_PROVIDER=gemini

# Google Gemini (Padrão do projeto)
# Obtenha sua chave gratuita em https://aistudio.google.com/
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_MODEL=gemini-3.5-flash-lite

# Groq Cloud (Opcional se AI_PROVIDER=groq)
# Obtenha em https://console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenAI GPT (Opcional se AI_PROVIDER=openai)
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxx

# Anthropic Claude (Opcional se AI_PROVIDER=claude)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxx

# ==========================================
# WhatsApp / Baileys Configurações
# ==========================================
AUTO_START_WHATSAPP=false

# ==========================================
# Google Calendar (Autenticação Global / Service Account)
# ==========================================
# 1. Ative a Google Calendar API no Google Cloud Console
# 2. Crie uma Service Account e gere uma Chave JSON
# 3. Compartilhe o Google Agenda com o e-mail da Service Account (permissão de editar eventos)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_CALENDAR_ID=primary
GOOGLE_TIMEZONE=America/Sao_Paulo
